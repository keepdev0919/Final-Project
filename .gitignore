.env
.venv/
__pycache__/
*.pyc
.DS_Store
.codex/
.claude/
.bkit/

# 대용량 DB / 벡터 스토어
storage/metadata.db
storage/vector_db/
storage/*.bak*
storage/*.db.bak*

# 잘못된 위치에 생성될 수 있는 빈 DB 파일 (실제 DB는 storage/metadata.db)
backend/jeju_folklore.db
backend/storage/metadata.db

# 로컬 IP가 박히는 파일 (start_dev.sh가 자동 갱신)
ios/JejuFolklore/Sources/App/Config.swift

# Google Maps API 키 등 시크릿 (Secrets.example.xcconfig 보고 자기 키 채워서 만듦)
ios/JejuFolklore/Resources/Secrets.xcconfig

# Firebase 키 파일 (Firebase Console 에서 다운로드)
ios/JejuFolklore/Resources/GoogleService-Info.plist
backend/firebase-admin.json

# Xcode 사용자 상태 파일
*.xcuserstate

# Xcode 빌드 산출물
ios/build/
build/

# LaTeX 빌드 부산물
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# 공모전 원본 배포자료 (대용량 바이너리 45MB · 로컬 보관, 요약은 _심사요약 md에)
docs/관광데이터 개발 공모전/**/*.docx
docs/관광데이터 개발 공모전/**/*.xlsx
docs/관광데이터 개발 공모전/**/*.zip

# 원본 데이터 파일
*.csv
*.CSV
*.pdf
*.hwp
관광사진/
관광정보/
관광지오디오/
연관관광지/
집중률 정보/
docs/미팅/
.gstack/

# TTS 목소리 샘플 (KTO 대본에서 생성 — 저장소에 두지 않는다)
docs/공유/tts-샘플/

# TTS 음성 캐시 (대본에서 생성 — 재생성 가능)
storage/tts_cache/

# 플러그인이 만드는 파일
skills-lock.json

# 오디 API 원본 스냅샷 — 대본 전문이 들어 있어 저장소에 넣지 않는다.
# 「대본은 저장하지 않는다」(backend/routers/odii.py 모듈 설명) 결정과 충돌한다.
# 필요하면 다시 뽑는다: scripts/dump_odii_raw.py
data/exports/오디_원본_API응답.json
data/exports/오디_원본_API응답.csv
