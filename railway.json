{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "backend/**",
      "data/**",
      "storage/metadata.db",
      "storage/tts_seed/**",
      "Dockerfile",
      ".dockerignore",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/privacy",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
